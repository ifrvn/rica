DATABASE_URL=postgresql://character:local-dev-only@127.0.0.1:55432/character
REDIS_URL=redis://127.0.0.1:56379
PORT=3000
RICA_MODEL_PROVIDER=simulated

# Set all management settings to enable /v1. Use a dedicated Rica management database login.
# RICA_MANAGEMENT_DATABASE_URL=postgresql://rica_management_login:example@127.0.0.1:55432/character
# RICA_IDP_INTROSPECTION_URL=https://identity.example.com/oauth2/introspect
# RICA_IDP_ISSUER=https://identity.example.com
# RICA_IDP_AUDIENCE=rica-management
# RICA_IDP_CLIENT_ID=rica-management
# RICA_IDP_CLIENT_SECRET=replace-me
# RICA_ADMIN_CREATOR_SUBJECTS=bootstrap-subject

# Set only in the one-shot Newbi pilot process.
# RICA_NEWBI_LOCAL_API_URL=http://localhost:5000/agent-api/v1
# NEWBI_AGENT_KEY=
# RICA_NEWBI_EXECUTION_DATABASE_URL=postgresql://rica_newbi_login:example@127.0.0.1:55432/character

# Required only for the separate simulation executor.
# RICA_SIMULATION_EXECUTION_DATABASE_URL=postgresql://rica_simulation_login:example@127.0.0.1:55432/character
