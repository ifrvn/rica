DATABASE_URL=postgresql://character:local-dev-only@127.0.0.1:55432/character
REDIS_URL=redis://127.0.0.1:56379
PORT=3000
# Model and Newbi API credentials are configured in the console.
# Optional protected settings directory shared by the API, worker and Newbi commands.
# RICA_MODEL_SETTINGS_DIR=/var/lib/rica/model-settings
# Optional absolute path to the deployment-managed plugin release manifest.
# RICA_PLUGIN_RELEASE_MANIFEST=/var/lib/rica/plugin-release.json
# Optional comma-separated allowlist shared by API, worker and simulation executor.
# RICA_SIMULATED_PLATFORMS=mock-a,mock-b

# Set the browser origin to enable the management API and local sign-in.
# RICA_ADMIN_ORIGIN=http://localhost:5173

# Existing Newbi deployments can continue to use the same endpoint and credential until saved in the console.
# RICA_NEWBI_LOCAL_API_URL=http://localhost:5000/agent-api/v1
# NEWBI_AGENT_KEY=
# Management API, simulation executor and Newbi commands use DATABASE_URL.
