{
  "name": "@ricajs/rica",
  "version": "0.1.0",
  "private": true,
  "description": "A multi-platform AI character runtime with a unified core self, isolated persona memory, and policy-controlled actions.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:generate": "prisma generate && prisma generate --schema plugins/newbi/prisma/schema.prisma",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc -p tsconfig.server.json && vue-tsc --noEmit",
    "test": "node --import tsx --test \"apps/*/*.test.ts\" \"packages/*/tests/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"scripts/*.integration.test.ts\" && tsx scripts/outbox-smoke.ts",
    "build": "vite build --config apps/admin/vite.config.ts",
    "release:pack": "node scripts/pack-release.mjs",
    "rica": "tsx bin/rica.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@ricajs/console-shared": "workspace:*",
    "@ricajs/contracts": "workspace:*",
    "@ricajs/persistence": "workspace:*",
    "@ricajs/plugin-host": "workspace:*",
    "@ricajs/plugin-hosted-models": "workspace:*",
    "@ricajs/plugin-newbi": "workspace:*",
    "@ricajs/runtime": "workspace:*",
    "@ricajs/simulation": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "bullmq": "^6.7.10",
    "dotenv": "^18.0.10",
    "hono": "^4.13.22",
    "ioredis": "^6.1.0",
    "prisma": "^7.10.1",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.46",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.159",
    "@types/node": "^24.19.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@unocss/preset-attributify": "^66.13.0",
    "@unocss/preset-icons": "^66.13.0",
    "@unocss/preset-wind4": "^66.13.0",
    "@vitejs/devtools": "^0.8.3",
    "@vitejs/plugin-vue": "^6.0.11",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unocss": "^66.13.0",
    "vite": "^8.4.0",
    "vite-plugin-vue-devtools": "^9.0.0-rc.4",
    "vue-tsc": "^3.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifrvn/rica.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "rica": "./bin/rica.js"
  }
}
