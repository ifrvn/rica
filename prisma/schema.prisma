generator client {
  provider = "prisma-client"
  output   = "../packages/persistence/generated"
}

datasource db {
  provider = "postgresql"
}

model OutboxEvent {
  eventId     String    @id @default(uuid()) @map("event_id") @db.Uuid
  type        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  enqueuedAt  DateTime? @map("enqueued_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz

  runId String?   @map("run_id") @db.Uuid
  run   AgentRun? @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([type, runId])
  @@index([processedAt, enqueuedAt, createdAt])
  @@map("outbox")
}

enum EntityStatus {
  ACTIVE
  PAUSED
}

enum AccountStatus {
  PENDING
  ACTIVE
  PAUSED
  REAUTH_REQUIRED
  REVOKED
}

enum InboundKind {
  POST
  REPLY
  MENTION
}

enum RunMode {
  SIMULATION
}

enum RunState {
  QUEUED
  CONTEXT_READY
  CANCELED
}

enum RunStateReason {
  ACCOUNT_UNAVAILABLE
  BINDING_CHANGED
  CONVERSATION_UNAVAILABLE
}

model Character {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String         @unique
  status            EntityStatus   @default(PAUSED)
  timezone          String         @default("UTC")
  activeCoreVersion Int?           @map("active_core_version")
  authEpoch         Int            @default(0) @map("auth_epoch")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  activeCore        CoreVersion?   @relation("ActiveCore", fields: [id, activeCoreVersion], references: [characterId, version], onDelete: NoAction, onUpdate: NoAction)
  coreVersions      CoreVersion[]  @relation("CharacterCoreVersions")
  identities        Identity[]
  memories          Memory[]
  memorySources     SourceRecord[]

  @@map("characters")
}

model CoreVersion {
  characterId String      @map("character_id") @db.Uuid
  version     Int
  hardProfile Json        @map("hard_profile")
  actorId     String      @map("actor_id")
  reason      String
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  character   Character   @relation("CharacterCoreVersions", fields: [characterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  activeFor   Character[] @relation("ActiveCore")
  runs        AgentRun[]

  @@id([characterId, version])
  @@map("core_versions")
}

model Identity {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId   String            @map("character_id") @db.Uuid
  slug          String
  status        EntityStatus      @default(PAUSED)
  activeVersion Int?              @map("active_version")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  character     Character         @relation(fields: [characterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  activeProfile IdentityVersion?  @relation("ActiveIdentity", fields: [characterId, id, activeVersion], references: [characterId, identityId, version], onDelete: NoAction, onUpdate: NoAction)
  versions      IdentityVersion[] @relation("IdentityVersions")
  accounts      PlatformAccount[]
  memories      Memory[]
  memorySources SourceRecord[]
  memoryGrants  MemoryGrant[]

  @@unique([characterId, id])
  @@unique([characterId, slug])
  @@map("identities")
}

model IdentityVersion {
  characterId String     @map("character_id") @db.Uuid
  identityId  String     @map("identity_id") @db.Uuid
  version     Int
  roleProfile Json       @map("role_profile")
  actorId     String     @map("actor_id")
  reason      String
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  identity    Identity   @relation("IdentityVersions", fields: [characterId, identityId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  activeFor   Identity[] @relation("ActiveIdentity")
  runs        AgentRun[]

  @@id([characterId, identityId, version])
  @@map("identity_versions")
}

model PlatformAccount {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId     String         @map("character_id") @db.Uuid
  identityId      String         @map("identity_id") @db.Uuid
  platform        String
  instanceKey     String         @map("instance_key")
  remoteAccountId String         @map("remote_account_id")
  status          AccountStatus  @default(PENDING)
  bindingVersion  Int            @default(1) @map("binding_version")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  identity        Identity       @relation(fields: [characterId, identityId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  inboundEvents   InboundEvent[]
  memories        Memory[]
  memorySources   SourceRecord[]
  memoryGrants    MemoryGrant[]
  contacts        Contact[]
  conversations   Conversation[]

  @@unique([characterId, identityId, id])
  @@unique([platform, instanceKey, remoteAccountId])
  @@map("platform_accounts")
}

model InboundEvent {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId    String          @map("character_id") @db.Uuid
  identityId     String          @map("identity_id") @db.Uuid
  accountId      String          @map("account_id") @db.Uuid
  sourceKey      String          @map("source_key") @db.VarChar(256)
  kind           InboundKind
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz
  receivedAt     DateTime        @default(now()) @map("received_at") @db.Timestamptz
  account        PlatformAccount @relation(fields: [characterId, identityId, accountId], references: [characterId, identityId, id], onDelete: Restrict, onUpdate: NoAction)
  runs           AgentRun[]
  conversationId String?         @map("conversation_id") @db.Uuid
  contactId      String?         @map("contact_id") @db.Uuid
  conversation   Conversation?   @relation(fields: [characterId, identityId, accountId, conversationId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction)
  contact        Contact?        @relation(fields: [characterId, identityId, accountId, contactId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([accountId, sourceKey])
  @@unique([characterId, identityId, accountId, id])
  @@map("inbound_events")
}

model AgentRun {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId     String          @map("character_id") @db.Uuid
  identityId      String          @map("identity_id") @db.Uuid
  accountId       String          @map("account_id") @db.Uuid
  inboundEventId  String          @unique @map("inbound_event_id") @db.Uuid
  coreVersion     Int             @map("core_version")
  identityVersion Int             @map("identity_version")
  bindingVersion  Int             @map("binding_version")
  authEpoch       Int             @map("auth_epoch")
  mode            RunMode         @default(SIMULATION)
  state           RunState        @default(QUEUED)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  inboundEvent    InboundEvent    @relation(fields: [characterId, identityId, accountId, inboundEventId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction)
  core            CoreVersion     @relation(fields: [characterId, coreVersion], references: [characterId, version], onDelete: Restrict, onUpdate: NoAction)
  identity        IdentityVersion @relation(fields: [characterId, identityId, identityVersion], references: [characterId, identityId, version], onDelete: Restrict, onUpdate: NoAction)

  stateVersion Int             @default(1) @map("state_version")
  stateReason  RunStateReason? @map("state_reason")
  outboxEvents OutboxEvent[]

  @@map("agent_runs")
}

enum MemoryScope {
  CORE
  IDENTITY
  ACCOUNT
  CONVERSATION
}

enum MemoryVisibility {
  PUBLIC
  PERSONAL
  CONFIDENTIAL
  RESTRICTED
}

enum MemoryStatus {
  ACTIVE
  REVOKED
}

enum MemoryPurpose {
  INTERNAL_CONTEXT
  DECISION_SUPPORT
  PUBLIC_REFERENCE
  PRIVATE_REPLY
}

model Memory {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId    String           @map("character_id") @db.Uuid
  identityId     String?          @map("identity_id") @db.Uuid
  accountId      String?          @map("account_id") @db.Uuid
  scope          MemoryScope
  visibility     MemoryVisibility
  status         MemoryStatus     @default(ACTIVE)
  content        String           @db.Text
  revision       Int              @default(1)
  importance     Float            @default(0.5)
  confidence     Float            @default(0.5)
  expiresAt      DateTime?        @map("expires_at") @db.Timestamptz
  coreApprovedAt DateTime?        @map("core_approved_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  character      Character        @relation(fields: [characterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  identity       Identity?        @relation(fields: [characterId, identityId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  account        PlatformAccount? @relation(fields: [characterId, identityId, accountId], references: [characterId, identityId, id], onDelete: Restrict, onUpdate: NoAction)
  sources        MemorySource[]
  grants         MemoryGrant[]
  conversationId String?          @map("conversation_id") @db.Uuid
  conversation   Conversation?    @relation(fields: [characterId, identityId, accountId, conversationId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([characterId, id])
  @@index([characterId, status, scope, identityId, accountId])
  @@map("memories")
}

model SourceRecord {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId    String           @map("character_id") @db.Uuid
  identityId     String?          @map("identity_id") @db.Uuid
  accountId      String?          @map("account_id") @db.Uuid
  kind           String
  sourceKey      String           @map("source_key")
  classification MemoryVisibility
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  character      Character        @relation(fields: [characterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  identity       Identity?        @relation(fields: [characterId, identityId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  account        PlatformAccount? @relation(fields: [characterId, identityId, accountId], references: [characterId, identityId, id], onDelete: Restrict, onUpdate: NoAction)
  memoryLinks    MemorySource[]
  conversationId String?          @map("conversation_id") @db.Uuid
  conversation   Conversation?    @relation(fields: [characterId, identityId, accountId, conversationId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([characterId, id])
  @@unique([characterId, kind, sourceKey])
  @@map("sources_registry")
}

model MemorySource {
  characterId String       @map("character_id") @db.Uuid
  memoryId    String       @map("memory_id") @db.Uuid
  sourceId    String       @map("source_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  memory      Memory       @relation(fields: [characterId, memoryId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  source      SourceRecord @relation(fields: [characterId, sourceId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([characterId, memoryId, sourceId])
  @@index([characterId, sourceId])
  @@map("memory_sources")
}

model MemoryGrant {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId             String           @map("character_id") @db.Uuid
  memoryId                String           @map("memory_id") @db.Uuid
  recipientIdentityId     String           @map("recipient_identity_id") @db.Uuid
  recipientAccountId      String?          @map("recipient_account_id") @db.Uuid
  purpose                 MemoryPurpose
  audience                String?
  validFrom               DateTime         @map("valid_from") @db.Timestamptz
  validUntil              DateTime         @map("valid_until") @db.Timestamptz
  revokedAt               DateTime?        @map("revoked_at") @db.Timestamptz
  approvedBy              String           @map("approved_by")
  reason                  String
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  memory                  Memory           @relation(fields: [characterId, memoryId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  recipientIdentity       Identity         @relation(fields: [characterId, recipientIdentityId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  recipientAccount        PlatformAccount? @relation(fields: [characterId, recipientIdentityId, recipientAccountId], references: [characterId, identityId, id], onDelete: Restrict, onUpdate: NoAction)
  recipientConversationId String?          @map("recipient_conversation_id") @db.Uuid
  recipientContactId      String?          @map("recipient_contact_id") @db.Uuid
  privateConversation     Conversation?    @relation(fields: [characterId, recipientIdentityId, recipientAccountId, recipientConversationId, recipientContactId], references: [characterId, identityId, accountId, id, privateContactId], onDelete: Restrict, onUpdate: NoAction, map: "memory_grants_private_recipient_fkey")

  @@index([characterId, recipientIdentityId, purpose, memoryId])
  @@map("memory_grants")
}

enum ConversationChannel {
  PUBLIC
  PRIVATE
}

model Contact {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId   String          @map("character_id") @db.Uuid
  identityId    String          @map("identity_id") @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  remoteKey     String          @map("remote_key")
  displayLabel  String?         @map("display_label")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  account       PlatformAccount @relation(fields: [characterId, identityId, accountId], references: [characterId, identityId, id], onDelete: Restrict, onUpdate: NoAction)
  conversations Conversation[]
  inboundEvents InboundEvent[]

  @@unique([characterId, identityId, accountId, id])
  @@unique([accountId, remoteKey])
  @@map("contacts")
}

model Conversation {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId      String              @map("character_id") @db.Uuid
  identityId       String              @map("identity_id") @db.Uuid
  accountId        String              @map("account_id") @db.Uuid
  remoteKey        String              @map("remote_key")
  channel          ConversationChannel
  privateContactId String?             @map("private_contact_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  account          PlatformAccount     @relation(fields: [characterId, identityId, accountId], references: [characterId, identityId, id], onDelete: Restrict, onUpdate: NoAction)
  privateContact   Contact?            @relation(fields: [characterId, identityId, accountId, privateContactId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction)
  inboundEvents    InboundEvent[]
  memories         Memory[]
  sources          SourceRecord[]
  privateGrants    MemoryGrant[]

  @@unique([characterId, identityId, accountId, id])
  @@unique([characterId, identityId, accountId, id, privateContactId], map: "conversations_private_recipient_key")
  @@unique([accountId, remoteKey])
  @@map("conversations")
}
