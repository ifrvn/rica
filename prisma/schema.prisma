generator client {
  provider = "prisma-client"
  output   = "../packages/persistence/generated"
}

datasource db {
  provider = "postgresql"
}

model OutboxEvent {
  eventId     String    @id @default(uuid()) @map("event_id") @db.Uuid
  type        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  enqueuedAt  DateTime? @map("enqueued_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  generation  Int       @default(0)
  attempts    Int       @default(0)
  attemptUntil DateTime? @map("attempt_until") @db.Timestamptz
  quarantinedAt DateTime? @map("quarantined_at") @db.Timestamptz

  runId String?   @map("run_id") @db.Uuid
  run   AgentRun? @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([type, runId])
  @@index([processedAt, enqueuedAt, createdAt])
  @@map("outbox")
}

enum EntityStatus {
  ACTIVE
  PAUSED
}

enum AccountStatus {
  PENDING
  ACTIVE
  PAUSED
  REAUTH_REQUIRED
  REVOKED
}

enum InboundKind {
  POST
  REPLY
  MENTION
}

enum RunMode {
  SIMULATION
}

enum RunState {
  QUEUED
  CONTEXT_READY
  DRAFTED
  CANCELED
  WAITING_APPROVAL
  READY
  REJECTED
  EXPIRED
  EXECUTING
  RECONCILING
  SIMULATED
  BLOCKED
}

enum RunStateReason {
  ACCOUNT_UNAVAILABLE
  BINDING_CHANGED
  CONVERSATION_UNAVAILABLE
  DRAFT_UNAVAILABLE
  SCHEDULE_CHANGED
}

model Character {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                  String                 @unique
  status                EntityStatus           @default(PAUSED)
  timezone              String                 @default("UTC")
  activeCoreVersion     Int?                   @map("active_core_version")
  authEpoch             Int                    @default(0) @map("auth_epoch")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz
  activeCore            CoreVersion?           @relation("ActiveCore", fields: [id, activeCoreVersion], references: [characterId, version], onDelete: NoAction, onUpdate: NoAction)
  coreVersions          CoreVersion[]          @relation("CharacterCoreVersions")
  identities            Identity[]
  memories              Memory[]
  memorySources         SourceRecord[]
  managementMemberships ManagementMembership[]
  managementAudit       ManagementAudit[]

  dailyEnergyProjections DailyEnergyProjection[]
  modelDailyUsage ModelDailyUsage[]
  @@map("characters")
}

model CoreVersion {
  characterId String      @map("character_id") @db.Uuid
  version     Int
  hardProfile Json        @map("hard_profile")
  actorId     String      @map("actor_id")
  reason      String
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  character   Character   @relation("CharacterCoreVersions", fields: [characterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  activeFor   Character[] @relation("ActiveCore")
  runs        AgentRun[]

  @@id([characterId, version])
  @@map("core_versions")
}

model Identity {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId   String            @map("character_id") @db.Uuid
  slug          String
  status        EntityStatus      @default(PAUSED)
  activeVersion Int?              @map("active_version")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  character     Character         @relation(fields: [characterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  activeProfile IdentityVersion?  @relation("ActiveIdentity", fields: [characterId, id, activeVersion], references: [characterId, identityId, version], onDelete: NoAction, onUpdate: NoAction)
  versions      IdentityVersion[] @relation("IdentityVersions")
  accounts      PlatformAccount[]
  memories      Memory[]
  memorySources SourceRecord[]
  memoryGrants  MemoryGrant[]

  @@unique([characterId, id])
  @@unique([characterId, slug])
  goals GoalVersion[]
  beliefs BeliefVersion[]
  reflections IdentityReflection[]

  @@map("identities")
}

model IdentityReflection {
  characterId      String   @map("character_id") @db.Uuid
  identityId       String   @map("identity_id") @db.Uuid
  utcDay           DateTime @map("utc_day") @db.Date
  coreVersion      Int      @map("core_version")
  identityVersion  Int      @map("identity_version")
  fictionalProfile Boolean  @map("fictional_profile")
  observedReceipts Int      @map("observed_receipts")
  unverifiedEvents Int      @map("unverified_events")
  candidateBeliefId String? @map("candidate_belief_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  identity         Identity @relation(fields: [characterId, identityId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)

  goals            GoalVersion[]

  @@id([characterId, identityId, utcDay])
  @@map("identity_reflections")
}

model BeliefVersion {
  characterId  String   @map("character_id") @db.Uuid
  identityId   String   @map("identity_id") @db.Uuid
  beliefId     String   @map("belief_id") @db.Uuid
  version      Int
  kind         String
  statement    String
  status       String
  confidence   Float
  reason       String
  actorId      String   @map("actor_id")
  restoredFrom Int?     @map("restored_from")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  identity     Identity @relation(fields: [characterId, identityId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  evidence     BeliefEvidence[]

  @@id([characterId, identityId, beliefId, version])
  @@map("belief_versions")
}

model BeliefEvidence {
  characterId    String        @map("character_id") @db.Uuid
  identityId     String        @map("identity_id") @db.Uuid
  beliefId       String        @map("belief_id") @db.Uuid
  version        Int
  sourceId       String        @map("source_id") @db.Uuid
  memoryId       String        @map("memory_id") @db.Uuid
  memoryRevision Int           @map("memory_revision")
  direction      String
  weight         Float
  belief         BeliefVersion @relation(fields: [characterId, identityId, beliefId, version], references: [characterId, identityId, beliefId, version], onDelete: Restrict, onUpdate: NoAction)
  provenance     MemorySource  @relation(fields: [characterId, memoryId, sourceId], references: [characterId, memoryId, sourceId], onDelete: Restrict, onUpdate: NoAction)

  @@id([characterId, identityId, beliefId, version, sourceId])
  @@index([characterId, memoryId, sourceId])
  @@map("belief_evidence")
}

model GoalVersion {
  characterId String   @map("character_id") @db.Uuid
  identityId  String   @map("identity_id") @db.Uuid
  goalId      String   @map("goal_id") @db.Uuid
  version     Int
  title       String
  status      String
  priority    Int
  budget      Int
  dueAt       DateTime @map("due_at") @db.Timestamptz
  nextStep    String?  @map("next_step")
  reason      String
  actorId     String   @map("actor_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  identity    Identity @relation(fields: [characterId, identityId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)

  origin       String   @default("ADMIN")
  topic        String?
  reflectionDay DateTime? @map("reflection_day") @db.Date
  reflection   IdentityReflection? @relation(fields: [characterId, identityId, reflectionDay], references: [characterId, identityId, utcDay], onDelete: Restrict, onUpdate: NoAction)

  @@id([characterId, identityId, goalId, version])
  @@index([characterId, identityId, reflectionDay])
  @@map("goal_versions")
}

model IdentityVersion {
  characterId String     @map("character_id") @db.Uuid
  identityId  String     @map("identity_id") @db.Uuid
  version     Int
  roleProfile Json       @map("role_profile")
  actorId     String     @map("actor_id")
  reason      String
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  identity    Identity   @relation("IdentityVersions", fields: [characterId, identityId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  activeFor   Identity[] @relation("ActiveIdentity")
  runs        AgentRun[]

  @@id([characterId, identityId, version])
  @@map("identity_versions")
}

model PlatformAccount {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId     String         @map("character_id") @db.Uuid
  identityId      String         @map("identity_id") @db.Uuid
  platform        String
  instanceKey     String         @map("instance_key")
  remoteAccountId String         @map("remote_account_id")
  status          AccountStatus  @default(PENDING)
  bindingVersion  Int            @default(1) @map("binding_version")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  identity        Identity       @relation(fields: [characterId, identityId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  inboundEvents   InboundEvent[]
  newbiReplies    NewbiReply[]
  newbiCheckpoint NewbiEventCheckpoint?
  newbiEvents     NewbiEvent[]
  memories        Memory[]
  memorySources   SourceRecord[]
  memoryGrants    MemoryGrant[]
  contacts        Contact[]
  conversations   Conversation[]

  @@unique([characterId, identityId, id])
  @@unique([platform, instanceKey, remoteAccountId])
  @@map("platform_accounts")
}

model NewbiEventCheckpoint {
  accountId         String          @id @map("account_id") @db.Uuid
  cursor            String?         @db.VarChar(2048)
  nextPollAt        DateTime        @default(now()) @map("next_poll_at") @db.Timestamptz
  ticket            String?         @db.Uuid
  leaseUntil        DateTime?       @map("lease_until") @db.Timestamptz
  historyLostCount  Int             @default(0) @map("history_lost_count")
  lastHistoryLostAt DateTime?       @map("last_history_lost_at") @db.Timestamptz
  account           PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("newbi_event_checkpoints")
}

model NewbiEvent {
  accountId  String          @map("account_id") @db.Uuid
  seq        String          @db.VarChar(40)
  type       String
  postId     String          @map("post_id") @db.Uuid
  commentId  String?         @map("comment_id") @db.Uuid
  occurredAt DateTime        @map("occurred_at") @db.Timestamptz
  account    PlatformAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([accountId, seq])
  @@index([accountId, occurredAt])
  @@index([occurredAt])
  @@map("newbi_events")
}

model NewbiReply {
  id              String @id @db.Uuid
  characterId     String @map("character_id") @db.Uuid
  identityId      String @map("identity_id") @db.Uuid
  accountId       String @map("account_id") @db.Uuid
  authEpoch       Int @map("auth_epoch")
  bindingVersion  Int @map("binding_version")
  postId          String @map("post_id") @db.Uuid
  content         String?
  reviewDigest    String @map("review_digest") @db.VarChar(64)
  executorKey     String @map("executor_key")
  approvedExecutorKey String? @map("approved_executor_key")
  proposerId      String @map("proposer_id")
  reviewerId      String? @map("reviewer_id")
  status          String @default("WAITING")
  attempts        Int @default(0)
  leaseUntil      DateTime? @map("lease_until") @db.Timestamptz
  retryNotBefore  DateTime? @map("retry_not_before") @db.Timestamptz
  closureReason   String? @map("closure_reason") @db.VarChar(240)
  remoteCommentId String? @map("remote_comment_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt       DateTime @map("expires_at") @db.Timestamptz
  account         PlatformAccount @relation(fields: [characterId,identityId,accountId], references: [characterId,identityId,id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([accountId,remoteCommentId])
  @@map("newbi_replies")
}

model InboundEvent {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId    String          @map("character_id") @db.Uuid
  identityId     String          @map("identity_id") @db.Uuid
  accountId      String          @map("account_id") @db.Uuid
  sourceKey      String          @map("source_key") @db.VarChar(256)
  messageText    String?         @map("message_text")
  bodyExpiredAt  DateTime?       @map("body_expired_at") @db.Timestamptz
  adapterId      String?         @map("adapter_id")
  adapterVersion String?         @map("adapter_version")
  kind           InboundKind
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz
  receivedAt     DateTime        @default(now()) @map("received_at") @db.Timestamptz
  account        PlatformAccount @relation(fields: [characterId, identityId, accountId], references: [characterId, identityId, id], onDelete: Restrict, onUpdate: NoAction)
  runs           AgentRun[]
  conversationId String?         @map("conversation_id") @db.Uuid
  contactId      String?         @map("contact_id") @db.Uuid
  conversation   Conversation?   @relation(fields: [characterId, identityId, accountId, conversationId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction)
  contact        Contact?        @relation(fields: [characterId, identityId, accountId, contactId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([accountId, sourceKey])
  @@unique([characterId, identityId, accountId, id])
  @@index([characterId, identityId, accountId, conversationId, contactId, occurredAt, id], map: "inbound_context_history_idx")
  @@index([characterId, identityId, receivedAt, id], map: "inbound_duplicate_window_idx")
  @@map("inbound_events")
}

model AgentRun {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId     String          @map("character_id") @db.Uuid
  identityId      String          @map("identity_id") @db.Uuid
  accountId       String          @map("account_id") @db.Uuid
  inboundEventId  String          @unique @map("inbound_event_id") @db.Uuid
  coreVersion     Int             @map("core_version")
  identityVersion Int             @map("identity_version")
  bindingVersion  Int             @map("binding_version")
  authEpoch       Int             @map("auth_epoch")
  mode            RunMode         @default(SIMULATION)
  state           RunState        @default(QUEUED)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  goalRefs Json @default("[]") @map("goal_refs")
  contextTimezone String?         @map("context_timezone")
  referencesExpiredAt DateTime?   @map("references_expired_at") @db.Timestamptz
  inboundEvent    InboundEvent    @relation(fields: [characterId, identityId, accountId, inboundEventId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction)
  core            CoreVersion     @relation(fields: [characterId, coreVersion], references: [characterId, version], onDelete: Restrict, onUpdate: NoAction)
  identity        IdentityVersion @relation(fields: [characterId, identityId, identityVersion], references: [characterId, identityId, version], onDelete: Restrict, onUpdate: NoAction)

  stateVersion Int             @default(1) @map("state_version")
  stateReason  RunStateReason? @map("state_reason")
  outboxEvents OutboxEvent[]

  snapshots          ContextSnapshot[]
  draft              SimulatedDraft?
  scheduleOccurrence ScheduleOccurrence?

  @@unique([characterId, id])
  identityStateRevisions IdentityStateRevision[]
  contactBoundaryVersion Int? @map("contact_boundary_version")
  @@map("agent_runs")
}

model DailyEnergyProjection {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  utcDay      DateTime  @map("utc_day") @db.Date
  energy      String
  actorId     String    @map("actor_id")
  reason      String
  approvedAt  DateTime  @default(now()) @map("approved_at") @db.Timestamptz
  character   Character @relation(fields: [characterId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([characterId, utcDay])
  @@map("daily_energy_projections")
}

model IdentityStateRevision {
  characterId String      @map("character_id") @db.Uuid
  identityId   String      @map("identity_id") @db.Uuid
  revision     Int
  runId        String      @unique @map("run_id") @db.Uuid
  eventId      String      @unique @map("event_id") @db.Uuid
  eventKind    InboundKind @map("event_kind")
  effectiveAt  DateTime    @map("effective_at") @db.Timestamptz
  throughAt    DateTime    @map("through_at") @db.Timestamptz
  throughEventId String    @map("through_event_id") @db.Uuid
  values       Float[]     @map("state_vector")
  ruleVersion  Int         @map("rule_version")
  actorId      String      @map("actor_id")
  appliedAt    DateTime    @default(dbgenerated("clock_timestamp()")) @map("applied_at") @db.Timestamptz
  run          AgentRun    @relation(fields: [characterId, runId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([characterId, identityId, revision])
  @@index([characterId, identityId, effectiveAt, eventId], map: "identity_state_event_order_idx")
  ruleConfiguration Json? @map("rule_configuration")
  @@map("identity_state_revisions")
}

enum MemoryScope {
  CORE
  IDENTITY
  ACCOUNT
  CONVERSATION
}

enum MemoryVisibility {
  PUBLIC
  PERSONAL
  CONFIDENTIAL
  RESTRICTED
}

enum MemoryStatus {
  ACTIVE
  REVOKED
}

enum MemoryPurpose {
  INTERNAL_CONTEXT
  DECISION_SUPPORT
  PUBLIC_REFERENCE
  PRIVATE_REPLY
}

model Memory {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId    String           @map("character_id") @db.Uuid
  identityId     String?          @map("identity_id") @db.Uuid
  accountId      String?          @map("account_id") @db.Uuid
  scope          MemoryScope
  visibility     MemoryVisibility
  status         MemoryStatus     @default(ACTIVE)
  content        String           @db.Text
  revision       Int              @default(1)
  importance     Float            @default(0.5)
  confidence     Float            @default(0.5)
  expiresAt      DateTime?        @map("expires_at") @db.Timestamptz
  coreApprovedAt DateTime?        @map("core_approved_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  character      Character        @relation(fields: [characterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  identity       Identity?        @relation(fields: [characterId, identityId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  account        PlatformAccount? @relation(fields: [characterId, identityId, accountId], references: [characterId, identityId, id], onDelete: Restrict, onUpdate: NoAction)
  sources        MemorySource[]
  grants         MemoryGrant[]
  conversationId String?          @map("conversation_id") @db.Uuid
  conversation   Conversation?    @relation(fields: [characterId, identityId, accountId, conversationId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction)

  parentMemoryId  String?  @map("parent_memory_id") @db.Uuid
  parentMemory    Memory?  @relation("MemoryDerivation", fields: [characterId, parentMemoryId], references: [characterId, id], onDelete: NoAction, onUpdate: NoAction)
  derivedMemories Memory[] @relation("MemoryDerivation")

  snapshotEvidence ContextSnapshotEvidence[]
  corrections MemoryCorrection[]

  @@unique([characterId, id])
  @@index([characterId, parentMemoryId])
  @@index([characterId, status, scope, identityId, accountId])
  @@map("memories")
}

model MemoryCorrection {
  characterId String   @map("character_id") @db.Uuid
  memoryId    String   @map("memory_id") @db.Uuid
  revision    Int
  actorId     String   @map("actor_id")
  reason      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  memory      Memory   @relation(fields: [characterId, memoryId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([characterId, memoryId, revision])
  @@map("memory_corrections")
}

model SourceRecord {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId    String           @map("character_id") @db.Uuid
  identityId     String?          @map("identity_id") @db.Uuid
  accountId      String?          @map("account_id") @db.Uuid
  kind           String
  sourceKey      String           @map("source_key")
  classification MemoryVisibility
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  character      Character        @relation(fields: [characterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  identity       Identity?        @relation(fields: [characterId, identityId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  account        PlatformAccount? @relation(fields: [characterId, identityId, accountId], references: [characterId, identityId, id], onDelete: Restrict, onUpdate: NoAction)
  memoryLinks    MemorySource[]
  conversationId String?          @map("conversation_id") @db.Uuid
  conversation   Conversation?    @relation(fields: [characterId, identityId, accountId, conversationId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([characterId, id])
  @@unique([characterId, kind, sourceKey])
  @@map("sources_registry")
}

model MemorySource {
  characterId String       @map("character_id") @db.Uuid
  memoryId    String       @map("memory_id") @db.Uuid
  sourceId    String       @map("source_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  memory      Memory       @relation(fields: [characterId, memoryId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  source      SourceRecord @relation(fields: [characterId, sourceId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([characterId, memoryId, sourceId])
  @@index([characterId, sourceId])
  beliefEvidence BeliefEvidence[]

  @@map("memory_sources")
}

model MemoryGrant {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId             String           @map("character_id") @db.Uuid
  memoryId                String           @map("memory_id") @db.Uuid
  recipientIdentityId     String           @map("recipient_identity_id") @db.Uuid
  recipientAccountId      String?          @map("recipient_account_id") @db.Uuid
  purpose                 MemoryPurpose
  audience                String?
  validFrom               DateTime         @map("valid_from") @db.Timestamptz
  validUntil              DateTime         @map("valid_until") @db.Timestamptz
  revokedAt               DateTime?        @map("revoked_at") @db.Timestamptz
  approvedBy              String           @map("approved_by")
  reason                  String
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz
  memory                  Memory           @relation(fields: [characterId, memoryId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  recipientIdentity       Identity         @relation(fields: [characterId, recipientIdentityId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  recipientAccount        PlatformAccount? @relation(fields: [characterId, recipientIdentityId, recipientAccountId], references: [characterId, identityId, id], onDelete: Restrict, onUpdate: NoAction)
  recipientConversationId String?          @map("recipient_conversation_id") @db.Uuid
  recipientContactId      String?          @map("recipient_contact_id") @db.Uuid
  privateConversation     Conversation?    @relation(fields: [characterId, recipientIdentityId, recipientAccountId, recipientConversationId, recipientContactId], references: [characterId, identityId, accountId, id, privateContactId], onDelete: Restrict, onUpdate: NoAction, map: "memory_grants_private_recipient_fkey")

  @@index([characterId, recipientIdentityId, purpose, memoryId])
  @@map("memory_grants")
}

enum ConversationChannel {
  PUBLIC
  PRIVATE
}

model Contact {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId   String               @map("character_id") @db.Uuid
  identityId    String               @map("identity_id") @db.Uuid
  accountId     String               @map("account_id") @db.Uuid
  remoteKey     String               @map("remote_key")
  displayLabel  String?              @map("display_label")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  account       PlatformAccount      @relation(fields: [characterId, identityId, accountId], references: [characterId, identityId, id], onDelete: Restrict, onUpdate: NoAction)
  noContactAt DateTime? @map("no_contact_at") @db.Timestamptz
  boundaryChangedAt DateTime? @map("boundary_changed_at") @db.Timestamptz
  boundaryVersion Int @default(0) @map("boundary_version")
  boundaryReason String? @map("boundary_reason")
  conversations Conversation[]
  inboundEvents InboundEvent[]
  schedules     SimulationSchedule[]

  @@unique([characterId, identityId, accountId, id])
  @@unique([accountId, remoteKey])
  @@map("contacts")
}

model Conversation {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId      String               @map("character_id") @db.Uuid
  identityId       String               @map("identity_id") @db.Uuid
  accountId        String               @map("account_id") @db.Uuid
  remoteKey        String               @map("remote_key")
  channel          ConversationChannel
  privateContactId String?              @map("private_contact_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  account          PlatformAccount      @relation(fields: [characterId, identityId, accountId], references: [characterId, identityId, id], onDelete: Restrict, onUpdate: NoAction)
  privateContact   Contact?             @relation(fields: [characterId, identityId, accountId, privateContactId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction)
  inboundEvents    InboundEvent[]
  schedules        SimulationSchedule[]
  memories         Memory[]
  sources          SourceRecord[]
  privateGrants    MemoryGrant[]

  @@unique([characterId, identityId, accountId, id])
  @@unique([characterId, identityId, accountId, id, privateContactId], map: "conversations_private_recipient_key")
  @@unique([accountId, remoteKey])
  @@map("conversations")
}

model ContextSnapshot {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId    String                    @map("character_id") @db.Uuid
  runId          String                    @map("run_id") @db.Uuid
  purpose        MemoryPurpose
  audienceKey    String                    @map("audience_key")
  queryDigest    String                    @map("query_digest") @db.VarChar(64)
  rankingVersion Int                       @map("ranking_version")
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  run            AgentRun                  @relation(fields: [characterId, runId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  evidence       ContextSnapshotEvidence[]

  @@unique([characterId, id])
  @@unique([runId, purpose, audienceKey])
  @@map("context_snapshots")
}

model ContextSnapshotEvidence {
  characterId     String          @map("character_id") @db.Uuid
  snapshotId      String          @map("snapshot_id") @db.Uuid
  memoryId        String          @map("memory_id") @db.Uuid
  memoryRevision  Int             @map("memory_revision")
  rank            Int
  score           Float
  estimatedTokens Int             @map("estimated_tokens")
  snapshot        ContextSnapshot @relation(fields: [characterId, snapshotId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  memory          Memory          @relation(fields: [characterId, memoryId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([characterId, snapshotId, rank])
  @@unique([characterId, snapshotId, memoryId])
  @@map("context_snapshot_evidence")
}

model SimulatedDraft {
  runId               String          @map("run_id") @db.Uuid
  characterId         String          @map("character_id") @db.Uuid
  content             String?
  decisionEvidenceIds String[]        @map("decision_evidence_ids") @db.Uuid
  writingEvidenceIds  String[]        @map("writing_evidence_ids") @db.Uuid
  citationIds         String[]        @map("citation_ids") @db.Uuid
  beliefRefs          Json            @default("[]") @map("belief_refs")
  modelId             String?         @map("model_id")
  modelVersion        String?         @map("model_version")
  proposal            ActionProposal?
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  run                 AgentRun        @relation(fields: [characterId, runId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([characterId, runId])
  @@map("simulated_drafts")
}

model AdminUser {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String         @unique @db.VarChar(64)
  passwordHash String         @map("password_hash") @db.VarChar(128)
  actorId      String         @unique @map("actor_id") @db.VarChar(64)
  canCreate    Boolean        @default(false) @map("can_create")
  authVersion  Int            @default(1) @map("auth_version")
  passkeys     AdminPasskey[]

  @@map("admin_users")
}

model AdminPasskey {
  id        String    @id @db.VarChar(1024)
  userId    String    @map("user_id") @db.Uuid
  publicKey Bytes     @map("public_key")
  counter   BigInt    @default(0)
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("admin_passkeys")
}

enum ManagementRole {
  ADMIN
  OPERATOR
  REVIEWER
  AUDITOR
}

model ManagementMembership {
  characterId String         @map("character_id") @db.Uuid
  issuer      String
  subject     String
  role        ManagementRole
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([characterId, issuer, subject, role])
  @@index([issuer, subject, characterId])
  @@map("management_memberships")
}

model ManagementAudit {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  actorId     String    @map("actor_id")
  operation   String
  targetId    String    @map("target_id") @db.Uuid
  requestId   String    @map("request_id") @db.Uuid
  digest      String    @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  character   Character @relation(fields: [characterId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([characterId, createdAt, id])
  @@map("audit_log")
}

model ManagementIdempotency {
  principalId String   @map("principal_id")
  routeScope  String   @map("route_scope")
  key         String
  requestHash String   @map("request_hash") @db.VarChar(64)
  response    Json
  expiresAt   DateTime @map("expires_at") @db.Timestamptz

  @@id([principalId, routeScope, key])
  @@index([expiresAt])
  @@map("api_idempotency")
}

enum ReviewDecision {
  APPROVE
  REJECT
}

model ActionProposal {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId       String             @map("character_id") @db.Uuid
  runId             String             @unique @map("run_id") @db.Uuid
  target            Json
  payloadHash       String             @map("payload_hash") @db.VarChar(64)
  reviewDigest      String             @map("review_digest") @db.VarChar(64)
  policyVersion     Int                @map("policy_version")
  crossPlatformDuplicate Boolean      @default(false) @map("cross_platform_duplicate")
  adapterId         String             @map("adapter_id")
  adapterVersion    String             @map("adapter_version")
  adapterContractVersion Int            @map("adapter_contract_version")
  proposerId        String?            @map("proposer_id")
  expiresAt         DateTime           @map("expires_at") @db.Timestamptz
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  draft             SimulatedDraft     @relation(fields: [characterId, runId], references: [characterId, runId], onDelete: Restrict, onUpdate: NoAction)
  approval          ActionApproval?
  simulationAttempt SimulationAttempt?

  @@unique([characterId, id])
  @@unique([characterId, runId])
  @@index([characterId, createdAt, id])
  @@map("action_proposals")
}

model ModelDailyUsage {
  characterId  String @map("character_id") @db.Uuid
  utcDay        DateTime @map("utc_day") @db.Date
  reservedUnits Int @default(0) @map("reserved_units")
  calls         Int @default(0)
  denied        Int @default(0)
  character     Character @relation(fields: [characterId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([characterId, utcDay])
  @@map("model_daily_usage")
}

model ActionApproval {
  actionId     String         @id @map("action_id") @db.Uuid
  characterId  String         @map("character_id") @db.Uuid
  reviewDigest String         @map("review_digest") @db.VarChar(64)
  reviewerId   String         @map("reviewer_id")
  decision     ReviewDecision
  reason       String
  expiresAt    DateTime       @map("expires_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  action       ActionProposal @relation(fields: [characterId, actionId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([characterId, actionId])
  @@map("action_approvals")
}

enum SimulationAttemptStatus {
  PERMITTED
  UNKNOWN
  CONFIRMED
  NOT_SENT
}

model SimulationAttempt {
  actionId           String                  @id @map("action_id") @db.Uuid
  characterId        String                  @map("character_id") @db.Uuid
  accountId          String                  @map("account_id") @db.Uuid
  contactId          String?                 @map("contact_id") @db.Uuid
  resolvedBy         String?                 @map("resolved_by")
  resolutionReason   String?                 @map("resolution_reason")
  resolutionEvidence String?                 @map("resolution_evidence")
  status             SimulationAttemptStatus @default(PERMITTED)
  reviewDigest       String                  @map("review_digest") @db.VarChar(64)
  windowStart        DateTime                @map("window_start") @db.Timestamptz
  permitUntil        DateTime                @map("permit_until") @db.Timestamptz
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz
  action             ActionProposal          @relation(fields: [characterId, actionId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  receipt            SimulationReceipt?

  @@unique([characterId, actionId])
  @@index([accountId, windowStart])
  @@index([accountId, contactId, permitUntil])
  @@index([status, permitUntil])
  @@map("simulation_attempts")
}

model SimulationReceipt {
  actionId    String                @id @map("action_id") @db.Uuid
  characterId String                @map("character_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  attempt     SimulationAttempt     @relation(fields: [characterId, actionId], references: [characterId, actionId], onDelete: Restrict, onUpdate: NoAction)
  commitment  SimulationCommitment?

  @@unique([characterId, actionId])
  @@index([characterId, createdAt])
  @@map("simulation_receipts")
}

enum ScheduleKind {
  DAILY
  REMINDER
}

model SimulationSchedule {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId    String                @map("character_id") @db.Uuid
  identityId     String                @map("identity_id") @db.Uuid
  accountId      String                @map("account_id") @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  contactId      String?               @map("contact_id") @db.Uuid
  scheduleKey    String                @map("schedule_key")
  zone           String
  kind           ScheduleKind
  localTime      String?               @map("local_time")
  dueAt          DateTime?             @map("due_at") @db.Timestamptz
  nextAt         DateTime?             @map("next_at") @db.Timestamptz
  enabled        Boolean               @default(true)
  version        Int                   @default(1)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  conversation   Conversation          @relation(fields: [characterId, identityId, accountId, conversationId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction, map: "simulation_schedules_conversation_fkey")
  contact        Contact?              @relation(fields: [characterId, identityId, accountId, contactId], references: [characterId, identityId, accountId, id], onDelete: Restrict, onUpdate: NoAction, map: "simulation_schedules_contact_fkey")
  occurrences    ScheduleOccurrence[]
  commitment     SimulationCommitment?

  @@unique([characterId, id])
  @@unique([characterId, scheduleKey])
  @@index([enabled, nextAt, id])
  @@map("simulation_schedules")
}

model ScheduleOccurrence {
  scheduleId      String             @map("schedule_id") @db.Uuid
  characterId     String             @map("character_id") @db.Uuid
  scheduledAt     DateTime           @map("scheduled_at") @db.Timestamptz
  scheduleVersion Int                @map("schedule_version")
  runId           String             @map("run_id") @db.Uuid
  schedule        SimulationSchedule @relation(fields: [characterId, scheduleId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  run             AgentRun           @relation(fields: [characterId, runId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([scheduleId, scheduledAt])
  @@unique([characterId, runId])
  @@map("schedule_occurrences")
}

enum CommitmentState {
  OPEN
  DEFERRED
  FULFILLED
  CANCELED
  EXPIRED
}

model SimulationCommitment {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  characterId String               @map("character_id") @db.Uuid
  actionId    String               @map("action_id") @db.Uuid
  scheduleId  String               @map("schedule_id") @db.Uuid
  title       String
  state       CommitmentState      @default(OPEN)
  dueAt       DateTime             @map("due_at") @db.Timestamptz
  version     Int                  @default(1)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz
  receipt     SimulationReceipt    @relation(fields: [characterId, actionId], references: [characterId, actionId], onDelete: Restrict, onUpdate: NoAction)
  schedule    SimulationSchedule   @relation(fields: [characterId, scheduleId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)
  revisions   CommitmentRevision[]

  @@unique([characterId, id])
  @@unique([characterId, actionId])
  @@unique([characterId, scheduleId])
  @@index([characterId, createdAt, id])
  @@map("simulation_commitments")
}

model CommitmentRevision {
  commitmentId String               @map("commitment_id") @db.Uuid
  characterId  String               @map("character_id") @db.Uuid
  version      Int
  state        CommitmentState
  dueAt        DateTime             @map("due_at") @db.Timestamptz
  reason       String
  actorId      String               @map("actor_id")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  commitment   SimulationCommitment @relation(fields: [characterId, commitmentId], references: [characterId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([commitmentId, version])
  @@map("commitment_revisions")
}
